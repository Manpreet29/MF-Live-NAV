# ============================================================
# MF NAV Tracker — Environment Variables
# ============================================================
# Copy to .env and fill in your values for local development.
# NEVER commit .env to git.
# ============================================================

# PostgreSQL connection string from Supabase
# Project Settings → Database → Connection string → URI
# Use the "Session" mode URL (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Admin secret — protects POST /api/admin/load-instruments
# Choose any long random string
ADMIN_SECRET=change-this-to-something-secret

# Leave these empty for local dev (defaults are fine)
# CORS_ORIGINS=["http://localhost:5173"]
